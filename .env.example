# Copie para .env e ajuste. Nunca suba o .env para o Git.

APP_NOME="Portal de Negociação"
APP_EMPRESA="ACME Financeira"
APP_URL=http://localhost:8080

# Chave para HMAC de CPF e códigos e para cifrar os links de campanha.
# Gere com: openssl rand -hex 32
APP_SEGREDO=

# 1 = mostra o código na tela em vez de enviar SMS e exibe a faixa de demonstração.
MODO_DEMO=1

# API do credor (o docker-compose sobe o simulador)
CREDOR_USUARIO=demo
CREDOR_SENHA=demo

# SMS: "log" grava em storage/sms.log; "webhook" faz POST {"to","message"} para SMS_WEBHOOK_URL
SMS_DRIVER=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Painel da operação (/painel). Gere com: php bin/senha-painel.php
PAINEL_SENHA_HASH=
